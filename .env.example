# PostgreSQL connection string
DATABASE_URL="postgresql://savemoney:savemoney@localhost:5432/savemoney"
# Long random string used to sign login sessions (openssl rand -hex 32)
AUTH_SECRET="change-me"
# Public URL of the site, used for Stripe redirects
APP_URL="http://localhost:3000"
# Stripe (https://dashboard.stripe.com/apikeys). Leave empty in development to unlock courses with a test button.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# First admin account created by the seed script
ADMIN_EMAIL="admin@savemoney.local"
ADMIN_PASSWORD="admin12345"
